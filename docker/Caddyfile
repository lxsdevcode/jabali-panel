{
	frankenphp {
		num_threads 4
	}
	order php_server before file_server

	# Disable Caddy admin API
	admin off

	# Disable automatic HTTPS/ACME — panel uses self-signed or certbot-managed certs
	auto_https off

	servers {
		protocols h1 h2 h3
	}
}

# Panel HTTPS server
:{$PANEL_PORT:2223} {
	root * {$APP_ROOT:/var/www/jabali}/public

	tls {$PANEL_TLS_CERT:/etc/ssl/jabali/panel.crt} {$PANEL_TLS_KEY:/etc/ssl/jabali/panel.key}

	encode zstd gzip

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		# HSTS is set by nginx when using a trusted cert — not here (self-signed would lock out browsers)
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Request size limit (512MB for file uploads)
	request_body {
		max_size 512MB
	}

	# Block sensitive paths (allow /vendor/livewire for Livewire JS assets)
	@blocked {
		path /vendor/*
		not path /vendor/livewire/*
	}
	respond @blocked 404

	@blocked_other path /node_modules/* /storage/* /.*
	respond @blocked_other 404

	php_server
}

