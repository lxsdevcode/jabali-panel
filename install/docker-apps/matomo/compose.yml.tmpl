services:
  matomo:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
      MATOMO_DATABASE_HOST: "db"
      MATOMO_DATABASE_USERNAME: "matomo"
      MATOMO_DATABASE_PASSWORD: "{{ index .Env "MATOMO_DATABASE_PASSWORD" }}"
      MATOMO_DATABASE_DBNAME: "matomo"
      MATOMO_DATABASE_ADAPTER: "mysql"
    volumes:
      - {{ .DataRoot }}/matomo:/var/www/html
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1/ -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  db:
    image: mariadb:11
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    command: --max-allowed-packet=64MB
    environment:
      MYSQL_DATABASE: "matomo"
      MYSQL_USER: "matomo"
      MYSQL_PASSWORD: "{{ index .Env "MATOMO_DATABASE_PASSWORD" }}"
      MYSQL_ROOT_PASSWORD: "{{ index .Env "MYSQL_ROOT_PASSWORD" }}"
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
