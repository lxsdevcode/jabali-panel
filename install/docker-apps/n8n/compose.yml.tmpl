services:
  n8n:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322).
      N8N_EMAIL_MODE: "smtp"
      N8N_SMTP_HOST: "{{ index .Env "SMTP_HOST" }}"
      N8N_SMTP_PORT: "{{ if (index .Env "SMTP_PORT") }}{{ index .Env "SMTP_PORT" }}{{ else }}587{{ end }}"
      N8N_SMTP_USER: "{{ index .Env "SMTP_USER" }}"
      N8N_SMTP_PASS: "{{ index .Env "SMTP_PASSWORD" }}"
      N8N_SMTP_SENDER: "{{ if (index .Env "SMTP_FROM") }}{{ index .Env "SMTP_FROM" }}{{ else }}n8n@{{ .Domain }}{{ end }}"
      N8N_SMTP_SSL: "{{ if eq (index .Env "SMTP_PORT") "465" }}true{{ else }}false{{ end }}"
{{- end }}
      N8N_HOST: "0.0.0.0"
      WEBHOOK_URL: "https://{{ .Domain }}/"
      N8N_EDITOR_BASE_URL: "https://{{ .Domain }}/"
{{- range $name, $val := .Env }}
      {{ $name }}: "{{ $val }}"
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/home/node/.n8n
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:5678/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
