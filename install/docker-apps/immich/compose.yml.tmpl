services:
  immich-server:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - postgres
      - redis
      - immich-machine-learning
    environment:
      DB_HOSTNAME: "postgres"
      DB_USERNAME: "postgres"
      DB_PASSWORD: "{{ index .Env "DB_PASSWORD" }}"
      DB_DATABASE_NAME: "immich"
      REDIS_HOSTNAME: "redis"
      IMMICH_MACHINE_LEARNING_URL: "http://immich-machine-learning:3003"
    volumes:
      - {{ .DataRoot }}/upload:/usr/src/app/upload
      - /etc/localtime:/etc/localtime:ro
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:2283/api/server-info/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:v1.119.1
    container_name: jabali-app-{{ .Slug }}-ml
    restart: unless-stopped
    volumes:
      - {{ .DataRoot }}/model-cache:/cache
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:3003/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  postgres:
    image: tensorchord/pgvecto-rs:pg16-v0.2.0
    container_name: jabali-app-{{ .Slug }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ index .Env "DB_PASSWORD" }}"
      POSTGRES_USER: "postgres"
      POSTGRES_DB: "immich"
    volumes:
      - {{ .DataRoot }}/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s

  redis:
    image: redis:7-alpine
    container_name: jabali-app-{{ .Slug }}-redis
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
