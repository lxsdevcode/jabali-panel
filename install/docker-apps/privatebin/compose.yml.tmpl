services:
  privatebin:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    read_only: true
    volumes:
      - {{ .DataRoot }}/data:/srv/data
    tmpfs:
      - /tmp
      - /var/tmp
      - /var/lib/nginx/tmp
      - /var/lib/nginx/logs
      - /var/log/nginx
      - /var/log/php-fpm
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8080/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
