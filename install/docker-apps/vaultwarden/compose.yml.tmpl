services:
  vaultwarden:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322).
      SMTP_HOST: "{{ index .Env "SMTP_HOST" }}"
      SMTP_PORT: "{{ if (index .Env "SMTP_PORT") }}{{ index .Env "SMTP_PORT" }}{{ else }}587{{ end }}"
      SMTP_SECURITY: "{{ if eq (index .Env "SMTP_PORT") "465" }}force_tls{{ else }}starttls{{ end }}"
      SMTP_USERNAME: "{{ index .Env "SMTP_USER" }}"
      SMTP_PASSWORD: "{{ index .Env "SMTP_PASSWORD" }}"
      SMTP_FROM: "{{ if (index .Env "SMTP_FROM") }}{{ index .Env "SMTP_FROM" }}{{ else }}vaultwarden@{{ .Domain }}{{ end }}"
      SMTP_FROM_NAME: "{{ if (index .Env "SMTP_FROM_NAME") }}{{ index .Env "SMTP_FROM_NAME" }}{{ else }}Vaultwarden{{ end }}"
{{- end }}
      DOMAIN: "https://{{ .Domain }}"
      WEBSOCKET_ENABLED: "true"
{{- range $name, $val := .Env }}
      {{ $name }}: "{{ $val }}"
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/data
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/alive || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
