services:
  nextcloud:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
      MYSQL_HOST: "db"
      MYSQL_DATABASE: "nextcloud"
      MYSQL_USER: "nextcloud"
      MYSQL_PASSWORD: "{{ index .Env "MYSQL_PASSWORD" }}"
      NEXTCLOUD_ADMIN_USER: "{{ index .Env "NEXTCLOUD_ADMIN_USER" }}"
      NEXTCLOUD_ADMIN_PASSWORD: "{{ index .Env "NEXTCLOUD_ADMIN_PASSWORD" }}"
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ .Domain }}"
      OVERWRITEPROTOCOL: "https"
      OVERWRITEHOST: "{{ .Domain }}"
    volumes:
      - {{ .DataRoot }}/nextcloud:/var/www/html
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1/status.php -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW --innodb-use-native-aio=0
    environment:
      MYSQL_DATABASE: "nextcloud"
      MYSQL_USER: "nextcloud"
      MYSQL_PASSWORD: "{{ index .Env "MYSQL_PASSWORD" }}"
      MYSQL_ROOT_PASSWORD: "{{ index .Env "MYSQL_ROOT_PASSWORD" }}"
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
