services:
  mealie:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- if (index .Env "SMTP_HOST") }}
      # Operator-supplied SMTP (GH #322) — values q-escaped so special chars
      # (e.g. API-key passwords) can't break the rendered compose YAML.
      SMTP_HOST: {{ q (index .Env "SMTP_HOST") }}
      SMTP_PORT: "{{ or (index .Env "SMTP_PORT") "587" }}"
      SMTP_FROM_NAME: {{ q (or (index .Env "SMTP_FROM_NAME") "Mealie") }}
      SMTP_FROM_EMAIL: {{ q (or (index .Env "SMTP_FROM") (printf "mealie@%s" .Domain)) }}
      SMTP_AUTH_STRATEGY: "{{ if eq (index .Env "SMTP_PORT") "465" }}SSL{{ else }}TLS{{ end }}"
      SMTP_USER: {{ q (index .Env "SMTP_USER") }}
      SMTP_PASSWORD: {{ q (index .Env "SMTP_PASSWORD") }}
{{- end }}
      BASE_URL: "https://{{ .Domain }}"
{{- range $name, $val := .Env }}
{{- if not (hasPrefix $name "SMTP_") }}
      {{ $name }}: {{ q $val }}
{{- end }}
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/app/data
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:9000/api/app/about || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 45s
