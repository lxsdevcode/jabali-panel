services:
  freshrss:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    environment:
{{- range $name, $val := .Env }}
      {{ $name }}: "{{ $val }}"
{{- end }}
    volumes:
      - {{ .DataRoot }}/data:/var/www/FreshRSS/data
      - {{ .DataRoot }}/extensions:/var/www/FreshRSS/extensions
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
