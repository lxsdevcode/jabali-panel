services:
  invoiceshelf:
    image: {{ .ImageChannel }}
    container_name: jabali-app-{{ .Slug }}
    restart: unless-stopped
    depends_on:
      - db
    environment:
      APP_ENV: "production"
      APP_DEBUG: "false"
      APP_URL: "https://{{ .Domain }}"
      APP_KEY: "{{ index .Env "APP_KEY" }}"
      DB_CONNECTION: "mariadb"
      DB_HOST: "db"
      DB_PORT: "3306"
      DB_DATABASE: "invoiceshelf"
      DB_USERNAME: "invoiceshelf"
      DB_PASSWORD: "{{ index .Env "DB_PASSWORD" }}"
      CACHE_STORE: "file"
      SESSION_DRIVER: "file"
      SESSION_DOMAIN: "{{ .Domain }}"
      SANCTUM_STATEFUL_DOMAINS: "{{ .Domain }}"
    volumes:
      - {{ .DataRoot }}/storage:/var/www/html/storage
    ports:
{{- with index .Ports "http" }}
      - "{{ .BindInterface }}:{{ .HostPort }}:{{ .ContainerPort }}/{{ .Protocol }}"
{{- end }}
    deploy:
      resources:
        limits:
          cpus: "{{ .CPULimit }}"
          memory: {{ .MemoryLimit }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/ -o /dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  db:
    image: mariadb:11
    container_name: jabali-app-{{ .Slug }}-db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: "invoiceshelf"
      MYSQL_USER: "invoiceshelf"
      MYSQL_PASSWORD: "{{ index .Env "DB_PASSWORD" }}"
      MYSQL_ROOT_PASSWORD: "{{ index .Env "MYSQL_ROOT_PASSWORD" }}"
    volumes:
      - {{ .DataRoot }}/db:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
