{
    "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp.schema.json",
    "mcpServers": {
        "mysql": {
            "command": "/home/shuki/.local/bin/mcp-ssh",
            "args": [
                "npx",
                "--yes",
                "@benborla29/mcp-server-mysql@latest"
            ],
            "env": {
                "MYSQL_HOST": "localhost",
                "MYSQL_USER": "root"
            },
            "description": "MySQL database access for development"
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "tailwindcss": {
            "command": "/home/shuki/.local/bin/mcp-ssh",
            "args": [
                "npx",
                "--yes",
                "tailwindcss-mcp-server"
            ],
            "description": "Tailwind CSS MCP server running on Raspberry Pi via SSH"
        }
    }
}
